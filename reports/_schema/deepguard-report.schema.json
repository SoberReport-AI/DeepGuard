{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deepguard-report.schema.json",
  "title": "DeepGuard Report Contract v3",
  "description": "DeepGuard 插件安全审计报告强制契约。报告只回答三个问题：检没检出恶意、检出了什么风险、检测过哪些东西。不设评分、不给修复建议。v3：人读字段一律为 {zh, en} 双语对象——Sonar 只写 zh（en 由翻译流程机械补齐），入库硬闸要求双语齐全。",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "metadata", "disclaimer", "plugin", "summary", "dimensions", "findings", "pipeline", "capability_diff", "version_diff", "market", "audit_scope", "methodology"],
  "properties": {
    "$schema": { "const": "deepguard-report/v3" },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "report_version", "generation_date", "auditor", "framework_version", "ruleset_version", "classification"],
      "properties": {
        "report_id": { "type": "string", "pattern": "^DG-\\d{8}-\\d{3}$" },
        "report_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "generation_date": { "type": "string", "format": "date-time" },
        "auditor": { "const": "DeepGuard Audit Agent" },
        "framework_version": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[\\w.+ -]+$" },
        "ruleset_version": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[\\w.+ -]+$" },
        "classification": { "const": "PUBLIC" },
        "audit_mode": {
          "description": "审计模式（平台侧事实，publish 阶段从 task.json 注入，agent 不得自填）：release-full=Release 轨迹完整审计；commit-diff=无 Release 仓库按时间快照的 HEAD diff 审计；full=无基线退化的完整审计",
          "enum": ["release-full", "commit-diff", "full"]
        },
        "release_tag": { "type": "string", "minLength": 1 }
      }
    },

    "disclaimer": {
      "description": "固定文案，中英双语逐字锁定，agent 不得增删改一字",
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": {
          "const": "本报告由 DeepGuard 审计 Agent 自动执行并生成。安全审计存在固有限制：静态分析无法覆盖全部运行时行为，动态观测无法穷尽全部触发路径，AI 语义判断可能存在漏报与误报。本报告的「未检出」结论仅表示在当前规则库版本、检测深度与时间窗口内未发现恶意行为或安全风险，不构成对该插件绝对安全、现在或未来均无恶意行为的任何保证；检出项亦可能因上下文差异存在偏差。本报告仅覆盖所标注的插件版本与 commit 快照，作者此后发布的新版本或对既有版本的任何改写（含 force-push）均不在覆盖范围内。用户安装与使用插件属自主行为，相关风险由用户自行评估与承担。DeepGuard 保留随规则库升级对历史版本重新审计并修订结论的权利。"
        },
        "en": {
          "const": "This report was automatically executed and generated by the DeepGuard Audit Agent. Security auditing has inherent limitations: static analysis cannot cover all runtime behavior, dynamic observation cannot exhaust all trigger paths, and AI-based semantic judgment may produce false negatives and false positives. A \"not detected\" conclusion in this report only means that no malicious behavior or security risk was found within the current ruleset version, detection depth, and time window; it does not constitute any guarantee that the plugin is absolutely safe or free of malicious behavior now or in the future. Detected items may also deviate due to contextual differences. This report covers only the plugin version and commit snapshot it identifies; any new version released by the author afterwards, or any rewrite of an existing version (including force-push), is outside its scope. Installing and using a plugin is the user's own decision, and the associated risks are assessed and borne by the user. DeepGuard reserves the right to re-audit historical versions and revise conclusions as the ruleset evolves."
        }
      }
    },

    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "commit", "source", "category", "author", "engines", "declared_capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$", "minLength": 3, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "必须完整 40 位 SHA（git rev-parse HEAD），拒绝短哈希：短前缀碰撞成本 ~2^16（GPU 分钟级），force-push 后可被同前缀恶意 commit 顶替" },
        "subpath": {
          "type": ["string", "null"],
          "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "maxLength": 200,
          "description": "monorepo 子路径（POSIX 相对路径，无前后斜杠、无 .. 段）；仓库根插件为 null。平台侧事实：必须与任务卡/队列 subpath 逐字一致（prepare 阶段据此把审计根裁剪到该子目录），agent 不得从插件文件中推断改写"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          }
        },
        "category": { "enum": ["ui", "tools", "sandbox", "bridge", "model", "memory", "workflow"] },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github", "verified"],
          "properties": {
            "github": { "type": "string", "minLength": 1 },
            "verified": { "type": "boolean" }
          }
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dsh"],
          "properties": { "dsh": { "type": "string", "minLength": 1 } }
        },
        "declared_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "shell", "fs", "modelFacing"],
          "properties": {
            "network": { "type": "boolean" },
            "shell": { "type": "boolean" },
            "fs": { "enum": [false, "read", "write", "full"] },
            "modelFacing": { "type": "boolean" }
          }
        },
        "meta_caps": {
          "type": "array",
          "items": { "enum": ["config-patch", "client-bundle"] },
          "uniqueItems": true,
          "description": "元能力徽章（可选；审计时机械判定的结构性事实，非风险结论）：config-patch=审计树内存在非空 cordis.patch.yml（叠加层可改写宿主配置与安全行）；client-bundle=manifest 声明 dsh.client（浏览器 bundle 自动进 __DSH_BOOT__）。sonar 机械填写，build-index 透传，前端渲染徽章；历史报告无此字段"
        }
      }
    },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_result", "dimension_overview", "key_findings", "version_signal"],
      "properties": {
        "overall_result": { "enum": ["clean", "risk", "blocked"] },
        "dimension_overview": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "status", "checked", "findings"],
            "properties": {
              "dimension": { "enum": ["DG-D1", "DG-D2", "DG-D3", "DG-D4", "DG-D5", "DG-D6"] },
              "status": { "enum": ["clean", "risk", "na"] },
              "checked": { "type": "integer", "minimum": 0 },
              "findings": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "key_findings": { "type": "array", "items": { "type": "string", "pattern": "^FND-\\d{3}$" } },
        "version_signal": { "enum": ["none", "changed", "force-push-suspect"] }
      }
    },

    "dimensions": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "name", "status", "checked_items", "ds_scenarios", "findings"],
        "properties": {
          "dimension": { "enum": ["DG-D1", "DG-D2", "DG-D3", "DG-D4", "DG-D5", "DG-D6"] },
          "name": {
            "description": "维度名称与 dimension 编号强绑定（zh/en 双双锁定，见 validate-report 语义检查）",
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "status": { "enum": ["clean", "risk", "na"] },
          "checked_items": {
            "description": "检测痕迹，不允许空头对勾：clean/na 也必须列出检测情况。大白话撰写：面向普通用户说清查了什么、结果如何，禁止内部规则/模块编号、grep/正则等扫描器术语、函数名变量名",
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["zh"],
              "properties": {
                "zh": { "type": "string", "minLength": 1 },
                "en": { "type": "string", "minLength": 1 }
              }
            }
          },
          "ds_scenarios": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^DG-S(0[1-9]|1[0-6])$" },
                "status": { "enum": ["pass", "fail", "na"] },
                "evidence": {
                  "description": "核查依据，大白话撰写（同 checked_items 文风），na 写明理由",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["zh"],
                  "properties": {
                    "zh": { "type": "string", "minLength": 1 },
                    "en": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "findings": { "type": "array", "items": { "type": "string", "pattern": "^FND-\\d{3}$" } }
        }
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "title", "severity", "confidence", "dimension", "rule_id", "description", "evidence", "impact"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^FND-\\d{3}$" },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "confidence": {
            "description": "证据置信度定档口径：confirmed=有动态确定性证据（沙箱金丝雀命中/宿主篡改等铁证）；high=静态与语义等多种手段证据一致；medium=单一手段检出、证据孤证。拿不准往低档定",
            "enum": ["confirmed", "high", "medium"]
          },
          "dimension": { "enum": ["DG-D1", "DG-D2", "DG-D3", "DG-D4", "DG-D5", "DG-D6"] },
          "rule_id": { "type": "string", "pattern": "^DG-R[1-6]-\\d{2}$" },
          "ds_scenario": { "type": "string", "pattern": "^DG-S(0[1-9]|1[0-6])$" },
          "threat_mapping": { "type": "string", "pattern": "^DG-T(0[1-9]|10)$" },
          "description": {
            "description": "审计发现：代码做了什么（机制、触发面、位置），只写事实；技术风格但让普通技术人员看懂，多段内容以空行（\\n\\n）分段",
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "impact": {
            "description": "风险分析三段：后果→触发条件→定级依据，段间以空行（\\n\\n）分隔",
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "pipeline": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "status", "summary"],
        "properties": {
          "layer": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
          "status": { "enum": ["pass", "risk", "fail", "na"] },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "capability_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "undeclared_observed", "declared_unobserved"],
      "properties": {
        "verdict": { "enum": ["match", "mismatch"] },
        "undeclared_observed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          }
        },
        "declared_unobserved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "version_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "new_install_hooks", "new_egress_domains", "capability_escalation", "tool_description_changed", "rug_pull_signal"],
      "properties": {
        "base": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "commit"],
              "properties": {
                "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            },
            { "type": "null", "description": "首次审计无基线" }
          ]
        },
        "new_install_hooks": { "type": "boolean" },
        "new_egress_domains": { "type": "array", "items": { "type": "string" } },
        "capability_escalation": { "type": "boolean" },
        "tool_description_changed": { "type": "boolean" },
        "rug_pull_signal": { "type": "boolean" }
      }
    },

    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "compat", "install_command"],
      "properties": {
        "verdict": { "enum": ["clean", "risk", "blocked"] },
        "compat": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dsh", "status"],
            "properties": {
              "dsh": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "warn", "fail", "untested"] }
            }
          }
        },
        "install_command": {
          "description": "机械可推导的固定值：dsh plugin --profile web add github:<owner>/<repo>#<commit40>（owner/repo 取自 plugin.source.url，commit 取自 plugin.commit；monorepo 时追加 &path:<plugin.subpath>，pnpm v9+ git 依赖子目录语法；publish 硬闸做等值校验，写任何其他值都会被拒）；blocked 判决须为 null",
          "type": ["string", "null"]
        }
      }
    },

    "audit_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "window", "limits"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh"],
          "properties": {
            "zh": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh"],
          "properties": {
            "zh": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh"],
          "properties": {
            "zh": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "layers"],
      "properties": {
        "modules": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^A-M[1-4]$" } },
        "layers": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] } }
      }
    }
  }
}
